<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: «3xui» monogram — three skewed bars + accent dot.
    Source design: bugs/design/3xui/project/components/shared.jsx AppIcon().
    Viewport 108×108 (Android), safe zone 21,21..87,87 → 66×66 dp.

    Design coordinates were 96×96 with bars at translate(20,26):
        bar1: M0,0 L46,0 L52,8 L8,8 Z          (opacity 1.0)
        bar2: M8,16 L54,16 L48,24 L2,24 Z      (opacity 0.85)
        bar3: M0,32 L46,32 L52,40 L8,40 Z      (opacity 0.7)
        dot:  cx=75 cy=22 r=4
    Mapped to 108×108 with origin shifted to center inside safe zone:
    scale factor = 108/96 ≈ 1.125; final translate ≈ (25, 30).

    Accent: oklch(0.85 0.18 145) — bright mint, sRGB ≈ #71E5A8.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="25" android:translateY="30">
        <!-- bar 1 (top) -->
        <path
            android:fillColor="#71E5A8"
            android:pathData="M0,0 L46,0 L52,8 L8,8 Z" />
        <!-- bar 2 (middle, 85% opacity) -->
        <path
            android:fillColor="#71E5A8"
            android:fillAlpha="0.85"
            android:pathData="M8,16 L54,16 L48,24 L2,24 Z" />
        <!-- bar 3 (bottom, 70% opacity) -->
        <path
            android:fillColor="#71E5A8"
            android:fillAlpha="0.7"
            android:pathData="M0,32 L46,32 L52,40 L8,40 Z" />
    </group>

    <!-- accent dot — upper-right of monogram -->
    <path
        android:fillColor="#71E5A8"
        android:pathData="M80,26 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

</vector>
