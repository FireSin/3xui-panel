<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (HTTP) is globally forbidden.
    Self-signed TLS is handled per-panel at OkHttp level (not here),
    so we don't weaken the entire app's security policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
